{
  "name": "aibyters-chart-library",
  "version": "0.1.0",
  "private": true,
  "description": "AI Byters Visual Intelligence Library — monorepo root",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18.18",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm -r --filter './packages/**' run build",
    "build:playground": "pnpm --filter playground build",
    "typecheck": "pnpm -r --filter './packages/**' run typecheck",
    "test": "vitest run",
    "test:visual": "node scripts/visual-check.mjs",
    "clean": "pnpm -r run clean",
    "size": "node scripts/bundle-size.mjs",
    "prebuild": "node scripts/copy-license.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "pnpm": {
    "overrides": {
      "d3-selection": "^3.0.0",
      "d3-transition": "^3.0.1",
      "d3-drag": "^3.0.0",
      "d3-dispatch": "^3.0.1",
      "d3-zoom": "^3.0.0",
      "d3-interpolate": "^3.0.1"
    }
  }
}
