{
  "name": "aibyters-charts-frappe-bundle",
  "version": "0.1.0",
  "private": true,
  "description": "Builds the self-contained Desk bundle (React + Recharts + AI Byters charts) into aibyters_charts/public/dist.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rimraf ../frappe-app/aibyters_charts/public/dist"
  },
  "dependencies": {
    "@aibyters/adapters-frappe": "workspace:*",
    "@aibyters/charts-bi": "workspace:*",
    "@aibyters/charts-ds": "workspace:*",
    "@aibyters/charts-kpi": "workspace:*",
    "@aibyters/core": "workspace:*",
    "@aibyters/layout": "workspace:*",
    "@aibyters/spec": "workspace:*",
    "@aibyters/theme": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21"
  }
}
