{
  "name": "@aibyters/charts-flow",
  "version": "0.1.0",
  "description": "Interactive flowcharts and process diagrams built on @xyflow/react.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aibyters/core": "workspace:*",
    "@aibyters/theme": "workspace:*",
    "@aibyters/tokens": "workspace:*",
    "clsx": "^2.1.1",
    "d3-transition": "^3.0.1",
    "tailwind-merge": "^2.6.1"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.6.0",
    "lucide-react": "^0.511.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@xyflow/react": "^12.6.0",
    "lucide-react": "^0.511.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  }
}
