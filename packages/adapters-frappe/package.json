{
  "name": "@aibyters/adapters-frappe",
  "version": "0.1.0",
  "description": "Frappe / ERPNext integration: Desk theme bridge, report/doctype data adapters, API client, and a config-driven dashboard renderer with an imperative mount for Desk pages.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" }
  },
  "files": ["dist", "LICENSE"],
  "publishConfig": { "access": "restricted" },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aibyters/charts-bi": "workspace:*",
    "@aibyters/charts-ds": "workspace:*",
    "@aibyters/charts-kpi": "workspace:*",
    "@aibyters/core": "workspace:*",
    "@aibyters/layout": "workspace:*",
    "@aibyters/spec": "workspace:*",
    "@aibyters/theme": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "recharts": "^2.15.4",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  }
}
