{
  "name": "@aibyters/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Draws a ChartSpec + DataFrame with the right AI Byters component",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@aibyters/charts-ai": "workspace:*",
    "@aibyters/charts-bi": "workspace:*",
    "@aibyters/charts-kpi": "workspace:*",
    "@aibyters/layout": "workspace:*",
    "@aibyters/spec": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^2.1.9"
  }
}
