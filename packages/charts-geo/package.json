{
  "name": "@aibyters/charts-geo",
  "version": "0.1.0",
  "description": "Geographic charts: choropleth, bubble map, connection map and Leaflet tile map.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aibyters/layout": "workspace:*",
    "@aibyters/spec": "workspace:*",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0"
  },
  "peerDependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-leaflet": "^4.2.1",
    "react-simple-maps": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-simple-maps": "^3.0.6",
    "@types/topojson-client": "^3.1.5",
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1",
    "react-simple-maps": "^3.0.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  }
}
