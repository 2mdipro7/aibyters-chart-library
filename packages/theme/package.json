{
  "name": "@aibyters/theme",
  "version": "0.1.0",
  "description": "Design tokens as CSS custom properties, ThemeProvider (dark / light / system / brand), and global styles.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": ["*.css", "./dist/index.js", "./dist/index.cjs"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./styles.css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css"
  },
  "files": ["dist", "LICENSE"],
  "publishConfig": { "access": "restricted" },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aibyters/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  }
}
